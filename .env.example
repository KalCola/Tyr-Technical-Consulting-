# Environment configuration for TYR Protocol Storefront
# Firebase AI Logic is provisioned via google-services.json and App Check (no raw API key required).
# Configure Stripe keys in the AI Studio Secrets panel for live Stripe Checkout Session API calls.
STRIPE_PUBLISHABLE_KEY=pk_test_TYR_STRIPE_PUBLISHABLE_KEY_PLACEHOLDER
STRIPE_SECRET_KEY=sk_test_TYR_STRIPE_SECRET_KEY_PLACEHOLDER
STRIPE_WEBHOOK_SECRET=whsec_TYR_STRIPE_WEBHOOK_SECRET_PLACEHOLDER
DOMAIN=https://tyrprotocol.pro
STRIPE_CHECKOUT_BASE_URL=https://buy.stripe.com/tyrprotocol
