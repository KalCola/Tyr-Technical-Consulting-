<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- SOC 2 CC6.6 & CC6.7: Strict Transport Security, zero cleartext traffic, system CA trust anchors -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
