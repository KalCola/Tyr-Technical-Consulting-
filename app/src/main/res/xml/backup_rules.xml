<?xml version="1.0" encoding="utf-8"?>
<!-- SOC 2 CC6.1 / CC6.5: Zero-Custody Backup Policy - Explicit exclusion of local data from device/cloud backup -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
